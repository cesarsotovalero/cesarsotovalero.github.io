---
layout: null
permalink: /feed.json
sitemap: false
---
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | jsonify }},
  "home_page_url": "{{ site.url }}/",
  "feed_url": "{{ site.url }}/feed.json",
  "description": {{ site.description | jsonify }},
  "language": "en",
  "authors": [{ "name": {{ site.data.authors.cesarsotovalero.name | jsonify }}, "url": "{{ site.url }}/about-me" }],
  "items": [{% for post in site.posts limit: 50 %}
    {
      "id": "{{ site.url }}{{ post.url }}",
      "url": "{{ site.url }}{{ post.url }}",
      "title": {{ post.title | strip | jsonify }},
      "summary": {{ post.description | default: post.subtitle | strip | jsonify }},
      "date_published": "{{ post.date | date_to_xmlschema }}",
      "tags": {{ post.tags | jsonify }}
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  ]
}
